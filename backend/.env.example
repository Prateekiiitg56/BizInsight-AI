# ─── BizInsight AI backend — environment variables ──────────────────────────
# Copy to backend/.env for local development. Everything except JWT_SECRET
# has a working default; leave a line commented out to use the default.

# ─── Security (REQUIRED in production) ──────────────────────────────────────
# A long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRY_HOURS=24

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API (localhost:3000 is always allowed).
# FRONTEND_URL=https://your-frontend.vercel.app
# Optional regex for preview deployments, e.g. ^https://your-app-.*\.vercel\.app$
# CORS_ORIGIN_REGEX=
# ALLOW_ALL_ORIGINS=false

# ─── LLM for the AI assistant (optional) ────────────────────────────────────
# Without a key the assistant still works in retrieval-only mode (returns matching reviews).
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ─── Google sign-in (optional) ──────────────────────────────────────────────
# Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ─── Database ────────────────────────────────────────────────────────────────
# Unset → SQLite file at backend/bizinsight.db (or DB_PATH).
# DATABASE_URL=postgresql://user:password@host:5432/bizinsight
# DB_PATH=./bizinsight.db

# ─── Vector store ────────────────────────────────────────────────────────────
# Unset → local ChromaDB in backend/chroma_db (or CHROMA_PERSIST_DIR).
# CHROMA_HOST=your-chroma-server.example.com
# CHROMA_PORT=8000

# ─── Misc ────────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB=10
# NLTK_DATA=/tmp/nltk_data
# LOG_LEVEL=INFO
# PORT=8001
