# ─── BizInsight AI — Environment Variables ────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# For local development, only OPENROUTER_API_KEY is needed.
# All other variables have sensible defaults for local dev (SQLite + local ChromaDB).

# ─── Local Development (defaults, no setup needed) ───────────────────────────
# Leave DATABASE_URL and CHROMA_HOST unset to use SQLite + local ChromaDB

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# ─── Authentication ──────────────────────────────────────────────────────────
# IMPORTANT: Change this in production!
JWT_SECRET=bizinsight-dev-secret-change-in-production

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Production Database (PostgreSQL) ────────────────────────────────────────
# Set this to switch from SQLite to PostgreSQL.
# When unset, SQLite is used automatically (zero setup for local dev).
# DATABASE_URL=postgresql://user:password@host:5432/bizinsight

# ─── Production Vector Store (Remote ChromaDB) ──────────────────────────────
# Set CHROMA_HOST to switch from local ChromaDB to a remote HTTP server.
# When unset, local ./chroma_db/ directory is used automatically.
# CHROMA_HOST=your-chroma-server.example.com
# CHROMA_PORT=8000

# ─── Frontend URL (CORS) ────────────────────────────────────────────────────
# FRONTEND_URL=https://your-frontend.vercel.app

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=8001
# ALLOW_ALL_ORIGINS=true
