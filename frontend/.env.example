# Copy to frontend/.env.local for local development.

# URL of the BizInsight backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8001

# Optional: enables "Continue with Google". Add your site's origin (e.g. http://localhost:3000)
# as an authorized JavaScript origin AND redirect URI in Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
